{
  "name": "LWAI Video Production",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm install && npx playwright install chromium --with-deps && npm install -g @anthropic-ai/claude-code",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Remotion Studio" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.vscode-typescript-next"]
    }
  }
}
